module HTTPX
  class GRPCError < Error
    attr_reader status: Integer
    attr_reader details: String
    attr_reader metadata: headers
  end

  module Plugins
    module GRPC
      DEADLINE: Integer
      MARSHAL_METHOD: Symbol
      UNMARSHAL_METHOD: Symbol
      HEADERS: Hash[String, String]

      type compression_option = bool | String
      type rpc_def = [String, untyped, untyped, Hash[Symbol, untyped]]

      type grpc_message = String | _Each[String]

      type grpc_request = untyped | _Each[untyped]
      type grpc_response = untyped | _Each[untyped]

      type credentials = Proc

      type grpcOptions = Options & Stream::OptionsMethods & OptionsMethods
      type grpcResponse = Response & Stream::ResponseMethods & ResponseMethods

      module OptionsMethods : Options, Stream::OptionsMethods
        attr_reader grpc_service: String?

        attr_reader grpc_compression: compression_option?

        attr_reader grpc_rpcs: Hash[String, rpc_def]

        attr_reader grpc_deadline: Float?

        attr_reader call_credentials: credentials?

        private

        def option_grpc_service: (_ToS value) -> String

        def option_grpc_compression: (bool) -> bool
                                   | (_ToS) -> String

        def option_grpc_rpcs: (_ToHash[String, rpc_def]) -> Hash[String, rpc_def]

        def option_grpc_deadline: (_ToF value) -> Float

        def option_call_credentials: (credentials) -> credentials
      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      def self.load_dependencies: (singleton(Session)) -> void

      def self.configure: (singleton(Session)) -> void

      module ResponseMethods : Response, Stream::ResponseMethods
        attr_reader trailing_metadata: Hash[String, untyped]

        def encoders: () -> Array[String | Encoding]

        # @override
        def merge_headers: (_Each[[String, headers_value]] trailers) -> void
      end

      module RequestBodyMethods : Request::Body
      end

      module InstanceMethods : Session, Persistent::InstanceMethods, Stream::InstanceMethods
        def with_channel_credentials: (String ca_path, ?String? key, ?String? cert, **untyped) -> instance

        def rpc: (_ToS rpc_name, untyped input, untyped output, **untyped) -> instance

        def build_stub: (string origin, ?service: _ToS, ?compression: compression_option) -> instance

        def execute:  (_ToS rpc_method, grpc_message input, ?deadline: Integer, ?metadata: headers_input, **untyped) -> Call

        private

        def rpc_execute: (_ToS rpc_method, grpc_request input, **untyped) -> Call

        def build_grpc_request: (string rpc_method, grpc_message input, deadline: Integer, ?metadata: headers_input?, **untyped) -> Request
      end
    end

    type grpcSession = Session & GRPC::InstanceMethods
  end
end
