module HTTPX
  module Plugins
    module DigestAuth
      type digestAuthOptions = Options & Auth::OptionsMethods & OptionsMethods
      type digestAuthRequest = Request & Auth::RequestMethods & Plugins::_WithOptions[digestAuthOptions]

      module OptionsMethods : Options, Auth::OptionsMethods
        attr_reader digest: Authentication::Digest?

        private

        def option_digest: (Authentication::Digest) -> Authentication::Digest
      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      def self.load_dependencies: (singleton(Session) klass) -> void

      module InstanceMethods : Session, Auth::InstanceMethods
        def digest_auth: (string user, string password, ?hashed: bool) -> instance

        private

        # @override
        def send_requests: (*digestAuthRequest requests) -> Array[response]
      end
    end
  end
end
