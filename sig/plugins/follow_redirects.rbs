module HTTPX
  InsecureRedirectError: singleton(Error)

  module Plugins
    module FollowRedirects
      MAX_REDIRECTS: Integer
      REDIRECT_STATUS: Range[Integer]
      REQUEST_BODY_HEADERS: Array[String]

      module OptionsMethods : Options
        attr_reader max_redirects: Integer?

        attr_reader follow_insecure_redirects: boolish

        attr_reader allow_auth_to_other_origins: boolish

        attr_reader redirect_on: (^(http_uri) -> boolish | nil)

        private

        def option_max_redirects: (_ToI value) -> Integer

        def option_follow_insecure_redirects: (boolish) -> boolish

        def option_allow_auth_to_other_origins: (boolish) -> boolish

        def option_redirect_on: [T] (T & ^(http_uri) -> boolish) -> T
      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      module InstanceMethods : Session
        def max_redirects: (_ToI) -> instance

        private

        def RequestMethods_headers: (http_uri original_uri, http_uri redirect_uri, Headers headers, OptionsMethods options) -> Headers

        def __get_location_from_response: (Response) -> http_uri
      end

      module RequestMethods : Request
        attr_accessor root_request: (Request & RequestMethods)?

        @RequestMethods: RequestMethods

        def RequestMethods: () -> RequestMethods

        def RequestMethods=: (RequestMethods req) -> void

        def max_redirects: () -> Integer
      end
    end

    type sessionFollowRedirects = FollowRedirects::InstanceMethods
  end
end
