module HTTPX
  module Plugins
    module Upgrade
      type upgradeOptions = Options & OptionsMethods
      type upgradeConnection = Connection & ConnectionMethods

      interface _Upgrader
        def call: (upgradeConnection connection, Request request, Response response) -> void
      end

      def self.configure: (singleton(Session)) -> void

      module OptionsMethods : Options
        attr_reader upgrade_handlers: Hash[String, _Upgrader]

        private

        def option_upgrade_handlers: (Hash[String, _Upgrader]) -> Hash[String, _Upgrader]
      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      module InstanceMethods : Session
        # @override
        def find_connection: (http_uri request_uri, Selector selector, Options options) -> upgradeConnection

        private

        # @override
        def fetch_response: (Request request, Selector selector, upgradeOptions options) -> response?
      end

      module ConnectionMethods : Connection
        attr_reader upgrade_protocol: String?
        attr_reader hijacked: boolish

        def hijack_io: () -> void
      end
    end
  end
end
