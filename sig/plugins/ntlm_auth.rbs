module HTTPX
  module Plugins
    module NTLMAuth
      type ntlmAuthOptions = Options & Auth::OptionsMethods & OptionsMethods
      type ntlmAuthRequest = Request & Auth::RequestMethods & Plugins::_WithOptions[ntlmAuthOptions]

      module OptionsMethods : Options, Auth::OptionsMethods
        attr_reader ntlm: Authentication::Ntlm?

        private

        def option_ntlm: (Authentication::Ntlm value) -> Authentication::Ntlm
      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      def self.load_dependencies: (singleton(Session) klass) -> void

      module InstanceMethods : Session, Auth::InstanceMethods
        def ntlm_auth: (string user, string password, ?string? domain) -> instance

        private

        # @override
        def send_requests: (*ntlmAuthRequest requests) -> Array[response]
      end

    end

    type sessionNTLMAuth = Session & NTLMAuth::InstanceMethods
  end
end
