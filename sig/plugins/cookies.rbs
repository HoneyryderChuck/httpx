module HTTPX
  module Plugins
    module Cookies
      type cookie_attributes = Hash[Symbol | String, top]

      type jar = Jar | _Each[Jar::cookie]

      type cookiesOptions = Options & OptionsMethods
      type cookiesHeaders = Headers & HeadersMethods
      type cookiesRequest = Request & _CookiesRequest & Plugins::_WithOptions[cookiesOptions]

      interface _CookiesRequest
        def headers: () -> cookiesHeaders
      end

      def self.load_dependencies: (singleton(Session)) -> void

      module OptionsMethods : Options
        attr_reader cookies: Jar

        private

        def merge_cookie_in_jar: (Array[String] cookies, Jar jar) -> void

        def option_cookies: (jar?) -> Jar
      end

      def self.extra_options: [T] (T & cookiesOptions options) -> T

      module InstanceMethods : Session
        extend Forwardable

        def cookies: () -> Jar

        def make_jar: (*untyped) -> Jar

        # @override 
        def build_request: (verb verb, generic_uri uri, ?request_params params, ?Options options) -> cookiesRequest

        private

        # @override
        def set_request_callbacks: (cookiesRequest request) -> void
      end

      module HeadersMethods : Headers
        def set_cookie: (Array[Cookie]) -> void
      end
    end
  end
end
