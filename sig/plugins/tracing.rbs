module HTTPX
  module Plugins
    module Tracing
      interface _Tracer
        def enabled?: (tracingRequest request) -> boolish

        def start: (tracingRequest request) -> void

        def reset: (tracingRequest request) -> void

        def finish: (tracingRequest request, response response) -> void
      end

      class Wrapper
        include _Tracer

        attr_reader tracers: Array[_Tracer]

        def initialize: (*_Tracer tracers) -> void

        def merge: (instance) -> void
      end

      interface _RetriesOptions
        def tracer: () -> _Tracer
      end

      module RequestMethods
        attr_accessor init_time: Time?

        attr_accessor handshake_time: Float?
      end

      module ConnectionMethods
        @init_time: Time?
      end

      module HTTP2Methods
        @handshake_time: Float?
        @handshake_init_time: Time

        def send: (tracingRequest request, ?bool head) -> bool
      end

      type tracingRequest = Request & RequestMethods
    end

    type sessionTracing = Session
  end
end