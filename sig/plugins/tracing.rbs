module HTTPX
  module Plugins
    module Tracing
      interface _Tracer
        def enabled?: (tracingRequest request) -> boolish

        def start: (tracingRequest request) -> void

        def reset: (tracingRequest request) -> void

        def finish: (tracingRequest request, response response) -> void
      end

      class Wrapper
        include _Tracer

        attr_reader tracers: Array[_Tracer]

        def initialize: (*_Tracer tracers) -> void

        def merge: (instance) -> void
      end

      module OptionsMethods : Options
        attr_reader tracer: Object & _Tracer

        private

        def option_tracer: [T] (T & _Tracer value) -> T
      end

      module RequestMethods : Request
        attr_accessor init_time: Time?

        attr_accessor handshake_time: Float?

        attr_accessor enqueue_time: Time?

        private

        def calculate_init_time: () -> Time
      end

      module ConnectionMethods : Connection
        @init_time: Time?
      end

      module HTTP2Methods : Connection::HTTP2
        @handshake_init_time: Time
        @pending: Array[tracingRequest]

        private

        def on_settings: (*untyped) -> void
      end

      type tracingRequest = Request & RequestMethods
    end
  end
end
