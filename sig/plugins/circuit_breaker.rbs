module HTTPX
  module Plugins
    module CircuitBreaker
      type circuitBreakerOptions = Options & OptionsMethods

      type circuitBreakerRequest = Request & Plugins::_WithOptions[circuitBreakerOptions]

      class CircuitStore
        @circuits: Hash[String, Circuit]

        @circuits_mutex: Thread::Mutex

        def try_open: (uri uri, response response) -> response?

        def try_respond: (Request request) -> response?

        def try_close: (http_uri uri) -> void

        private

        def get_circuit_for_uri: (uri uri) -> Circuit

        def initialize: (circuitBreakerOptions options) -> void
      end

      class Circuit
        @state: :closed | :open | :half_open
        @max_attempts: Integer
        @reset_attempts_in: Float
        @break_in: Float
        @circuit_breaker_half_open_drip_rate: Float
        @attempts: Integer
        @real_attempts: Integer
        @drip_factor: Integer

        @response: response?
        @opened_at: Float?
        @attempted_at: Float?

        def respond: () -> response?

        def try_open: (response) -> response?

        def try_close: () -> void

        private

        def initialize: (Integer max_attempts, Float reset_attempts_in, Float break_in, Float circuit_breaker_half_open_drip_rate) -> void
      end

      module OptionsMethods : Options
        attr_reader circuit_breaker_max_attempts: Integer

        attr_reader circuit_breaker_reset_attempts_in: Float

        attr_reader circuit_breaker_break_in: Float

        attr_reader circuit_breaker_half_open_drip_rate: Float

        attr_reader circuit_breaker_break_on: ^(Response) -> boolish

        private

        def option_circuit_breaker_max_attempts: (_ToI values) -> Integer

        def option_circuit_breaker_reset_attempts_in: (_ToF value) -> Float

        def option_circuit_breaker_break_in: (_ToF value) -> Float

        def option_circuit_breaker_half_open_drip_rate: (_ToF value) -> Float

        def option_circuit_breaker_break_on: (^(Response) -> boolish) -> (^(Response) -> boolish)
      end

      def self.load_dependencies: (singleton(Session)) -> void

      def self.extra_options: (circuitBreakerOptions options) -> circuitBreakerOptions

      module InstanceMethods : Session
        include HTTPX::Callbacks

        @circuit_store: CircuitStore

        private

        # @override 
        def set_request_callbacks: (circuitBreakerRequest request) -> void

        def try_circuit_open: (circuitBreakerRequest request, response response) -> response?
      end
    end
  end
end
