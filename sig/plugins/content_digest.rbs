module HTTPX
  module Plugins
    module ContentDigest
      class Error < HTTPX::Error
      end
      class ValidationError < Error
        attr_reader response: Response

        def initialize: (String message, Response response) -> void
      end
      class MissingContentDigestError < ValidationError
      end
      class InvalidContentDigestError < ValidationError
      end

      SUPPORTED_ALGORITHMS: Hash[String, singleton(OpenSSL::Digest)]

      type contentDigestOptions = Options & OptionsMethods
      type contentDigestResponse = Response & ResponseMethods
      type contentDigestResponseBody = Response::Body & ResponseBodyMethods

      module OptionsMethods : Options
        attr_reader content_digest_algorithm: String

        attr_reader encode_content_digest: bool | ^(Request) -> boolish

        attr_reader validate_content_digest: bool | ^(contentDigestResponse) -> boolish

        private

        def option_content_digest_algorithm: (String) -> String

        def option_encode_content_digest: (bool) -> bool
                                        | (^(Request) -> boolish) -> (^(Request) -> boolish)

        def option_validate_content_digest: (bool) -> bool
                                          | (^(contentDigestResponse) -> boolish) -> (^(contentDigestResponse) -> boolish)
      end

      def self.extra_options: [T] (T & Options options) -> T

      module InstanceMethods : Session
        private

        def validate_content_digest: (contentDigestResponse response) -> void

        def extract_content_digests: (String) -> Hash[String, String]

        def base64digest: (Request::Body | ResponseBodyMethods body) -> String
      end

      module ResponseMethods : Response
        # attr_reader body: ResponseBodyMethods
      end

      module ResponseBodyMethods : Response::Body
        attr_reader content_digest_buffer: Response::Buffer?

        # @override
        def initialize: (contentDigestResponse response, contentDigestOptions options) -> void
      end
    end
  end
end
