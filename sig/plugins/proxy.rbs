module HTTPX
  class ProxyError < ConnectionError
  end

  class ProxySSL < SSL
    attr_reader proxy_io: TCP | SSL
  end

  module Plugins
    interface _Authenticator
      def authenticate: (Request request, String authenticate) -> String
    end

    module Proxy
      class ProxyConnectionError < ProxyError
      end

      PROXY_ERRORS: Array[singleton(StandardError)]

      class Parameters
        attr_reader uri: URI::Generic?
        attr_reader username: String?
        attr_reader password: String?
        attr_reader scheme: String?
        attr_reader no_proxy: Array[String]?

        @ns: Integer
        @uris: Array[URI::Generic | String]
        @initial_credentials: boolish
        @authenticator: _Authenticator

        def shift: () -> void

        def can_authenticate?: (*untyped) -> boolish

        def authenticate: (*untyped) -> String?

        def ==: (untyped) -> bool

        private

        def initialize: (?uri: generic_uri | Array[generic_uri], ?ns: Integer, ?scheme: String?, ?username: String?, ?password: String?, ?no_proxy: Array[generic_uri] | generic_uri | nil, **untyped) -> void

        def infer_default_auth_scheme: (URI::Generic uri) -> String?

        def load_authenticator: (String scheme, String username, String password, **untyped) -> _Authenticator
      end

      def self.configure: (singleton(Session)) -> void

      module OptionsMethods : Options
        attr_reader proxy: Parameters?

        def supported_proxy_protocols: () -> Array[String]?

        private

        def option_proxy: (Parameters | _ToHash[Symbol, untyped] value) -> Parameters

        def option_supported_proxy_protocols: (Array[_ToS] value) -> Array[String]

      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      module ConnectionMethods : Connection
        @proxy_uri: generic_uri
      end

      module InstanceMethods : Session
        @proxy_parameters: Parameters?

        private

        def proxy_error?: (Request request, response, OptionsMethods options) -> bool
      end
    end

    type sessionProxy = Session & Proxy::InstanceMethods
  end
end
