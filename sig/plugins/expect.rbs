module HTTPX
  module Plugins
    module Expect
      EXPECT_TIMEOUT: Integer
      NOEXPECT_STORE_MUTEX: Thread::Mutex

      self.@no_expect_store: Store
      def self.no_expect_store: () -> Store

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      class Store
        @store: Array[String]
        @mutex: Thread::Mutex

        def include?: (String host) -> bool

        def add: (String host) -> void

        def delete: (String host) -> void
      end

      module RequestMethods : Request
        @informational_status: Integer?
      end

      module OptionsMethods : Options
        attr_reader expect_timeout: Float?

        attr_reader expect_threshold_size: Integer?

        private

        def option_expect_timeout: (_ToF value) -> Float

        def option_expect_threshold_size: (_ToI value) -> Integer
      end
    end
  end
end
