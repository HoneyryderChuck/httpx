module HTTPX
  module Plugins
    module AwsSdkAuthentication
      type awsSdkAuthenticationOptions = Options & AWSSigV4::OptionsMethods & OptionsMethods

      class Configuration
        attr_reader profile: String?

        private

        def initialize: (String? profile) -> void
      end

      class Credentials
        @aws_credentials: untyped

        include _SigV4Credentials

        private

        def initialize: (untyped aws_credentials) -> untyped
      end

      def self.load_dependencies: (singleton(Session)) -> void

      def self.configure: (singleton(Session)) -> void

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      def self.credentials: (String? profile) -> Credentials

      def self.region: (String? profile) -> String

      module OptionsMethods : Options
        attr_reader aws_profile: String?

        private

        def option_aws_profile: (_ToS value) -> String?
      end

      module InstanceMethods : Session, AWSSigV4::InstanceMethods
        def aws_sdk_authentication: (?credentials: Credentials, ?region: String, **untyped) -> instance
      end
    end
  end
end
