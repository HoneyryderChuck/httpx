module HTTPX
  module Plugins
    module FiberConcurrency
      type fiberConcurrencyRequest = Request & RequestMethods
      type fiberConcurrencyConnection = Connection & ConnectionMethods

      def self.subplugins: () -> Hash[Symbol, Module]

      module InstanceMethods : Session
        private

        # @override
        def send_request: (fiberConcurrencyRequest request, Selector selector, ?Options options) ?{ (Connection) -> void } -> void
      end

      module RequestMethods : Request
        attr_reader context: Fiber?

        def set_context!: () -> void

        def current_context?: () -> boolish
      end

      module ConnectionMethods : Connection

        def current_context?: () -> boolish

        def closed_for_select?: () -> bool

        def send: (fiberConcurrencyRequest request) -> void

        def pending_count: () -> Integer

        private

        def backlog?: () -> bool
      end

      module HTTP1Methods : Connection::HTTP1
      end

      module HTTP2Methods : Connection::HTTP2
        @contexts: Hash[Fiber?, Set[fiberConcurrencyRequest]]

        # @override
        def send: (fiberConcurrencyRequest request, ?bool head) -> bool

        private

        # @override
        def on_stream_close: (::HTTP2::Stream stream, fiberConcurrencyRequest request, (Symbol | StandardError)? error) -> void

        # @override
        def teardown: (?fiberConcurrencyRequest? request) -> void

        def add_to_context: (fiberConcurrencyRequest request) -> void

        def clear_from_context: (fiberConcurrencyRequest request) -> void
      end

      module ResolverNativeMethods : Resolver::Native
      end

      module ResolverSystemMethods : Resolver::System
        private

        def current_context?: () -> boolish
      end

      module FiberConcurrencyH2C
        module HTTP2Methods : Connection::HTTP2, FiberConcurrency::HTTP2Methods
          def upgrade: (fiberConcurrencyRequest request, Response response) -> void
        end
      end

      module FiberConcurrencyStream
        type fiberConcurrencyStreamRequest = Request & Stream::RequestMethods & FiberConcurrency::RequestMethods

        module StreamResponseMethods : StreamResponse
          def close: () -> void
        end
      end
    end
  end
end
