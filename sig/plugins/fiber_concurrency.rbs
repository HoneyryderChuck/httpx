module HTTPX
  module Plugins
    module FiberConcurrency
      module InstanceMethods : Session
      end

      module RequestMethods : Request
        attr_reader context: Fiber?

        def set_context!: () -> void

        def current_context?: () -> boolish
      end

      module ConnectionMethods : Connection

        def current_context?: () -> boolish

        def send: (RequestMethods request) -> void

        private

        def backlog?: () -> bool
      end

      module HTTP1Methods : Connection::HTTP1
      end

      module HTTP2Methods : Connection::HTTP2
        @contexts: Hash[Fiber, Set[Request]]

        private

        def add_to_context: (RequestMethods request) -> void

        def clear_from_context: (RequestMethods request) -> void
      end

      module NativeResolverMethods : Resolver::Native
      end

      module SystemResolverMethods : Resolver::System
      end

      module FiberConcurrencyH2C
        module HTTP2Methods : Connection::HTTP2
        end
      end

       module FiberConcurrencyStream
        module StreamResponseMethods : StreamResponse
          def close: () -> void
        end
      end
    end
  end
end
