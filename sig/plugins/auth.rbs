module HTTPX
  module Plugins
    module Auth
      type authOptions = Options & OptionsMethods
      type authRequest = Request & RequestMethods

      def self.subplugins: () -> Hash[Symbol, Module]

      type auth_header_value_type = String | ^(?authRequest request, ?bool should_regenerate) -> string

      module OptionsMethods : Options
        attr_reader auth_header_value: auth_header_value_type?

        attr_reader auth_header_type: String?

        attr_reader auth_header_expires_at: (^(authRequest request) -> _ToF | (Object & _ToF))?

        attr_reader auth_header_expires_in: Float?

        attr_reader generate_auth_value_on_retry: (^(response response) -> boolish)?

        private

        def option_auth_header_value: (auth_header_value_type) -> auth_header_value_type

        def option_auth_header_type: (String) -> String

        def option_auth_header_expires_at: (^(authRequest request) -> _ToF) -> (^(authRequest request) -> _ToF)
                                         | (Object & _ToF) -> (Object & _ToF)

        def option_auth_header_expires_in: (Object & _ToF) -> Float

        def option_generate_auth_value_on_retry: (^(response response) -> boolish) -> ^(response response) -> boolish
      end

      module InstanceMethods : Session
        @auth_header_value: String?
        @auth_header_value_mtx: Thread::Mutex
        @skip_auth_header_value: bool
        @auth_header_expires_at: interval?

        def authorization: (?string token, ?auth_header_type: string) ?{ (?authRequest, ?bool) -> string } -> instance

        def bearer_auth: (?string token) ?{ (authRequest) -> string } -> instance

        def skip_auth_header: [T] { () -> T } -> T

        def reset_auth_header_value!: () -> void

        private

        # @override
        def send_request: (authRequest request, Selector selector, ?Options options) ?{ (Connection) -> void } -> void

        def generate_auth_token: (authRequest request, bool should_regenerate) -> String?

        def try_invalidate_auth_header_value: () -> void

        def set_auth_header_expires_at: (authRequest request) -> void

        def dynamic_auth_token?: (auth_header_value_type? auth_header_value) -> boolish
      end

      module RequestMethods : Request
        attr_reader auth_token_value: String?

        @auth_header_value: String?

        def authorized?: () -> bool

        def unauthorize!: () -> void

        def authorize: (String auth_value) -> void
      end

      module AuthRetries
        type authRetriesOptions = Options & Auth::OptionsMethods & Retries::OptionsMethods

        type authRetriesRequest = Request & Auth::RequestMethods & Retries::RequestMethods & Plugins::_WithOptions[authRetriesOptions]

        module InstanceMethods : Session, Auth::InstanceMethods, Retries::InstanceMethods
          private

          # @override
          def retryable_request?: (authRetriesRequest request, Retries::retriesResponse | ErrorResponse response, authRetriesOptions options) -> boolish

          # @override
          def retryable_response?: (Retries::retriesResponse | ErrorResponse response, authRetriesOptions options) -> boolish

          # @override
          def prepare_to_retry: (authRetriesRequest request, Retries::retriesResponse | ErrorResponse response, interval? retry_after) -> void

          # @override
          def when_to_retry: (authRetriesRequest request, Retries::retriesResponse | ErrorResponse response, authRetriesOptions options) -> interval?

          # @override
          def auth_error?: (response response, Options & Auth::OptionsMethods options) -> boolish
        end
      end
    end
  end
end
