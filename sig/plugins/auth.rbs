module HTTPX
  module Plugins
    module Auth
      type auth_header_value_type = String | ^(?requestAuth request, ?bool should_regenerate) -> string

      module OptionsMethods : Options
        attr_reader auth_header_value: auth_header_value_type?

        attr_reader auth_header_type: String?

        attr_reader auth_header_expires_at: (^(requestAuth request) -> _ToF | (Object & _ToF))?

        attr_reader auth_header_expires_in: Float?

        attr_reader generate_auth_value_on_retry: (^(response response) -> boolish)?

        private

        def option_auth_header_value: (auth_header_value_type) -> auth_header_value_type

        def option_auth_header_type: (String) -> String

        def option_auth_header_expires_at: (^(requestAuth request) -> _ToF) -> (^(requestAuth request) -> _ToF)
                                         | (Object & _ToF) -> (Object & _ToF)

        def option_auth_header_expires_in: (Object & _ToF) -> Float

        def option_generate_auth_value_on_retry: (^(response response) -> boolish) -> ^(response response) -> boolish
      end

      module InstanceMethods : Session
        @auth_header_value: String?
        @auth_header_value_mtx: Thread::Mutex
        @skip_auth_header_value: bool
        @auth_header_expires_at: interval?

        def authorization: (?string token, ?auth_header_type: string) ?{ (?requestAuth, ?bool) -> string } -> instance

        def bearer_auth: (?string token) ?{ (requestAuth) -> string } -> instance

        def skip_auth_header: [T] { () -> T } -> T

        def reset_auth_header_value!: () -> void

        private

        def generate_auth_token: (requestAuth request, bool should_regenerate) -> String?

        def try_invalidate_auth_header_value: () -> void

        def set_auth_header_expires_at: (requestAuth request) -> void

        def dynamic_auth_token?: (auth_header_value_type auth_header_value) -> boolish
      end

      module RequestMethods : Request
        attr_reader auth_token_value: String?

        @auth_header_value: String?

        def authorized?: () -> bool

        def unauthorize!: () -> void

        def authorize: (String auth_value) -> void
      end

      module AuthRetries
        module InstanceMethods : Session
          private

          def auth_error?: (response response, Options options) -> boolish
        end
      end

      type requestAuth = Request & RequestMethods
    end

    type sessionAuth = Session & Auth::InstanceMethods
  end
end
