module HTTPX
  module Plugins
    module NTLMV2Auth
      type ntlmV2AuthOptions = Options & Auth::OptionsMethods & OptionsMethods
      type ntlmV2AuthRequest = Request & Auth::RequestMethods & Plugins::_WithOptions[ntlmV2AuthOptions]

      class Authenticator
        @user: String
        @password: String
        @domain: String?

        def can_authenticate?: (String? www_authenticate) -> boolish

        def authenticate: (Request request, String authenticate) -> String

        def negotiate: () -> String

        private

        def initialize: (string user, string password, ?domain: String?) -> void
      end

      module OptionsMethods : Options, Auth::OptionsMethods
        attr_reader ntlm: Authenticator?

        private

        def option_ntlm: (Authenticator) -> Authenticator
      end

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      def self.load_dependencies: (singleton(Session) klass) -> void

      module InstanceMethods : Session, Auth::InstanceMethods
        def ntlm_auth: (string user, string password, ?string? domain) -> instance

        private

        # @override
        def send_requests: (*ntlmV2AuthRequest requests) -> Array[response]
      end

    end

    type sessionNTLMV2Auth = Session & NTLMV2Auth::InstanceMethods
  end
end
