module HTTPX
  module Plugins
    module Cache
      def self.load_dependencies: (singleton(Session) klass) -> void

      def self.extra_options: [T] (T & OptionsMethods options) -> T

      interface _CacheStore
        def get: (RequestMethods request) -> ResponseMethods?

        def set: (RequestMethods request, ResponseMethods response) -> void

        def clear: () -> void
      end

      module OptionsMethods
        attr_reader cache_key: (^(RequestMethods) -> String)?

        attr_reader cacheable_request: (^(RequestMethods) -> boolish)?

        attr_reader cacheable_response: (^(RequestMethods, ResponseMethods) -> boolish)?

        attr_reader valid_cached_response: (^(RequestMethods, ResponseMethods) -> boolish)?

        attr_reader response_cache_store: Store

         private

        def option_cache_key: (^(RequestMethods) -> String) -> (^(RequestMethods) -> String)

        def option_cacheable_request: (^(RequestMethods) -> boolish) -> (^(RequestMethods) -> boolish)

        def option_cacheable_response: (^(RequestMethods, ResponseMethods) -> boolish) -> ((^(RequestMethods, ResponseMethods) -> boolish))

        def option_valid_cached_response: (^(RequestMethods, ResponseMethods) -> boolish) -> ((^(RequestMethods, ResponseMethods) -> boolish))

         def option_response_cache_store: (:store) -> Store
                                        | (:file_store) -> FileStore
                                        | [T] (T & _CacheStore) -> T
      end

      module InstanceMethods : Session
        def clear_response_cache: () -> void

        private

        def cacheable_request?: (RequestMethods request) -> boolish

        def cacheable_response?: (RequestMethods request, ResponseMethods response) -> boolish

        def valid_cached_response?: (RequestMethods request, ResponseMethods cached_response) -> boolish

        def prepare_cache: (RequestMethods request) -> void

        def retrieve_cached_response: (RequestMethods request) -> ResponseMethods?
      end

      module RequestMethods : Request
        attr_accessor cached_response: ResponseMethods?
        # attr_reader options: OptionsMethods

        def response_cache_key: () -> String?
      end

      module ResponseMethods : Response
        attr_writer original_request: RequestMethods

        @cached: bool

        def original_request: () -> RequestMethods?

        def cached?: () -> bool

        def mark_as_cached!: () -> void
      end
    end
  end
end
