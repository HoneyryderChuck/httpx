module HTTPX
  module Plugins
    module Hedging
      module OptionsMethods : Options
        attr_reader hedge_after: (^(requestHedging request, Response response) -> interval | interval)?

        private

        def option_hedge_after: (^(requestHedging request, Response response) -> interval) -> (^(requestHedging request, Response response) -> interval)
                              | (_ToF value) -> interval
      end

      module InstanceMethods : Session
        private

        def hedge_connection: (connectionHedging connection) -> connectionHedging

        def hedge_request!: (requestHedging request, connectionHedging connection, Selector selector) -> void

        def when_to_hedge: (requestHedging request) -> interval?
      end

      module RequestMethods : Request
        attr_reader hedge_request: requestHedging?

        @is_hedge_request: bool

        def hedge_request=: (requestHedging? request) -> void
      end

      module ConnectionMethods : Connection
        attr_reader hedge_connection: connectionHedging?

        attr_accessor is_hedge_connection: bool

        def hedge_connection=: (connectionHedging? connection) -> void

        def try_yield_connection: [T] () { (connectionHedging) -> T } -> T
      end
    end

    type sessionHedging = Session & Hedging::InstanceMethods

    type requestHedging = Request & Hedging::RequestMethods

    type connectionHedging = Connection & Hedging::ConnectionMethods
  end
end