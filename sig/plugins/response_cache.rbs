module HTTPX
  module Plugins
    module ResponseCache
      CACHEABLE_VERBS: Array[verb]
      CACHEABLE_STATUS_CODES: Array[Integer]
      SUPPORTED_VARY_HEADERS: Array[String]

      def self?.cacheable_response?: (::HTTPX::ErrorResponse | ResponseMethods response) -> bool

      def self?.not_modified?: (response response) -> bool

      module OptionsMethods : Cache::OptionsMethods
        attr_reader supported_vary_headers: Array[String]

        private

        def option_supported_vary_headers: (Array[String] value) -> Array[String]
      end

      module InstanceMethods : Cache::InstanceMethods
        private

        def match_by_vary?: (RequestMethods request, ResponseMethods response) -> bool
      end

      module RequestMethods : Cache::RequestMethods
        # attr_accessor cached_response: ResponseMethods?
        # attr_reader options: OptionsMethods

        @response_cache_key: String

        private

        def cacheable_verb?: () -> bool
      end

      module ResponseMethods : Cache::ResponseMethods
        attr_writer revalidated_at: Time

        @cache_control: Array[String]?

        @vary: Array[String]?

        @date: Time?

        def copy_from_cached!: () -> void

        def fresh?: () -> bool

        %a{pure} def cache_control: () -> Array[String]?

        %a{pure} def vary: () -> Array[String]?

        private

        def age: () -> Integer

        def date: () -> Time
      end
    end
  end
end
