module HTTPX
  module Plugins
    module ResponseCache
      CACHEABLE_VERBS: Array[verb]
      CACHEABLE_STATUS_CODES: Array[Integer]
      SUPPORTED_VARY_HEADERS: Array[String]

      type responseCacheOptions = Options & Cache::OptionsMethods & OptionsMethods
      type responseCacheRequest = Request & Cache::RequestMethods & RequestMethods
      type responseCacheResponse = Response & Cache::ResponseMethods & ResponseMethods

      def self.load_dependencies: (singleton(Session) klass) -> void

      def self.extra_options: [T] (T & Options options) -> T

      def self?.cacheable_response?: (responseCacheResponse | ErrorResponse response) -> bool

      def self?.not_modified?: (response response) -> bool

      module OptionsMethods : Options, Cache::OptionsMethods
        attr_reader supported_vary_headers: Array[String]

        private

        def option_supported_vary_headers: (Array[String] value) -> Array[String]
      end

      module InstanceMethods : Session, Cache::InstanceMethods
        private

        # @override
        def fetch_response: (responseCacheRequest request, Selector selector, Options options) -> response?

        def prepare_cache: (responseCacheRequest request) -> void

        def cacheable_request?: (responseCacheRequest request) -> boolish

        def cacheable_response?: (responseCacheRequest request, responseCacheResponse response) -> boolish

        def valid_cached_response?: (responseCacheRequest request, responseCacheResponse cached_response) -> boolish

        def retrieve_cached_response: (responseCacheRequest request) -> responseCacheResponse?

        def match_by_vary?: (responseCacheRequest request, responseCacheResponse response) -> bool
      end

      module RequestMethods : Request, Cache::RequestMethods
        @response_cache_key: String

        def cached_response: () -> responseCacheResponse?

        def response_cache_key: () -> String

        def cacheable_verb?: () -> bool
      end

      module ResponseMethods : Response, Cache::ResponseMethods
        attr_writer revalidated_at: Time

        @cache_control: Array[String]?

        @vary: Array[String]?

        @date: Time?

        def original_request: () -> responseCacheRequest?

        def copy_from_cached!: () -> void

        def fresh?: () -> bool

        %a{pure} def cache_control: () -> Array[String]?

        %a{pure} def vary: () -> Array[String]?

        private

        def age: () -> Integer

        def date: () -> Time
      end
    end
  end
end
