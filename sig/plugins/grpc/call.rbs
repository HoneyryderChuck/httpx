module HTTPX
  module Plugins
    module GRPC
      class Call
        attr_writer decoder: _Callable

        @response: ResponseMethods | StreamResponse
        @consumed: bool
        @grpc_response: Enumerator[String] | String

        def metadata: () -> headers

        def trailing_metadata: () -> headers?

        private

        def initialize: (ResponseMethods | StreamResponse response) -> untyped

        def grpc_response: () -> grpc_response
      end
    end
  end
end
