module HTTPX
  class ServerSideRequestForgeryError < Error
  end

  module Plugins
    module SsrfFilter
      type ssrfFilterOptions = Options & OptionsMethods
      type ssrfFilterConnection = Connection & ConnectionMethods

      IPV4_BLACKLIST: Array[IPAddr]

      IPV6_BLACKLIST: Array[[IPAddr, IPAddr]]

      def self?.unsafe_ip_address?: (IPAddr ipaddr) -> bool

      def self.extra_options: (ssrfFilterOptions options) -> ssrfFilterOptions

      module OptionsMethods : Options
        attr_reader allowed_schemes: Array[String]

        attr_reader extra_unsafe_ranges: Array[IPAddr]?

        attr_reader safe_private_ranges: Array[IPAddr]?

        private

        def option_allowed_schemes: (Array[String] value) -> Array[String]

        def option_extra_unsafe_ranges: (Array[IPAddr] value) -> Array[IPAddr]

        def option_safe_private_ranges: (Array[IPAddr] value) -> Array[IPAddr]
      end

      module InstanceMethods : Session
      end

      module ConnectionMethods : Connection
      end
    end
  end
end
