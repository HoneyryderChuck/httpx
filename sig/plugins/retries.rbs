module HTTPX
  module Plugins
    module Retries
      MAX_RETRIES: Integer
      IDEMPOTENT_METHODS: Array[String]
      RECONNECTABLE_ERRORS: Array[singleton(StandardError)]
      RETRYABLE_ERRORS: Array[singleton(StandardError)]
      DEFAULT_JITTER: ^(interval) -> interval
      BACKOFF_ALGORITHMS: Array[Symbol]

      def self?.retry_after_polynomial_backoff: (retriesRequest request, retriesResponse | ErrorResponse response) -> interval

      def self?.retry_after_exponential_backoff: (retriesRequest request, retriesResponse | ErrorResponse response) -> interval

      type retriesOptions = Options & OptionsMethods
      type retriesRequest = Request & RequestMethods
      type retriesResponse = Response & ResponseMethods

      interface _RetryCallback
        def call: (retriesResponse | ErrorResponse response) -> bool?
      end

      module OptionsMethods : Options
        attr_reader retry_after: (^(retriesRequest request, retriesResponse | ErrorResponse response) -> interval | interval)?

        attr_reader retry_jitter: ^(interval jitter) -> interval

        attr_reader max_retries: Integer

        attr_reader retry_change_requests: boolish

        attr_reader retry_on: _RetryCallback?

        private

        def option_retry_after: [T] (T & ^(retriesRequest request, retriesResponse | ErrorResponse response) -> interval) -> T
                              | (Symbol value) -> (^(retriesRequest request, retriesResponse | ErrorResponse response) -> interval)
                              | (_ToF value) -> Float

        def option_retry_jitter: [T] (^(interval jitter) -> interval) -> T

        def option_max_retries: (_ToI value) -> Integer

        def option_retry_change_requests: (boolish) -> boolish

        def option_retry_on: (_RetryCallback value) -> _RetryCallback
      end

      def self.extra_options: [T] (T & retriesOptions options) -> T

      module InstanceMethods : Session
        def max_retries: (int) -> instance

        private

        def fetch_response: (retriesRequest request, Selector selector, retriesOptions options) -> (retriesResponse | ErrorResponse)?

        def retryable_request?: (retriesRequest request, retriesResponse | ErrorResponse response, retriesOptions options) -> boolish

        def retryable_response?: (retriesResponse | ErrorResponse response, retriesOptions options) -> boolish

        def retryable_error?: (_Exception error, retriesOptions options) -> boolish

        def try_partial_retry: (retriesRequest request, retriesResponse | ErrorResponse response) -> void

        def prepare_to_retry: (retriesRequest request, retriesResponse | ErrorResponse response, interval? retry_after) -> void

        def can_reconnect?: (retriesRequest request, retriesResponse | ErrorResponse response) -> bool

        def when_to_retry: (retriesRequest request, retriesResponse | ErrorResponse response, retriesOptions options) -> interval?
      end

      module RequestMethods : Request
        # attr_reader options: OptionsMethods

        attr_accessor retries: Integer

        attr_writer partial_response: retriesResponse?

        def response=: (retriesResponse | ErrorResponse response) -> void
      end

      module ResponseMethods : Response
        def from_partial_response: (retriesResponse response) -> void
      end
    end
  end
end
