module HTTPX
  module Plugins
    module Retries
      MAX_RETRIES: Integer
      IDEMPOTENT_METHODS: Array[String]
      RECONNECTABLE_ERRORS: Array[singleton(StandardError)]
      RETRYABLE_ERRORS: Array[singleton(StandardError)]
      DEFAULT_JITTER: ^(interval) -> interval
      BACKOFF_ALGORITHMS: Array[Symbol]

      def self?.retry_after_polynomial_backoff: (RequestMethods request, ResponseMethods | ErrorResponse response) -> interval

      def self?.retry_after_exponential_backoff: (RequestMethods request, ResponseMethods | ErrorResponse response) -> interval

      interface _RetryCallback
        def call: (ResponseMethods | ErrorResponse response) -> bool?
      end

      module OptionsMethods : Options
        attr_reader retry_after: (^(RequestMethods request, ResponseMethods | ErrorResponse response) -> interval | interval)?

        attr_reader retry_jitter: ^(interval jitter) -> interval

        attr_reader max_retries: Integer

        attr_reader retry_change_requests: boolish

        attr_reader retry_on: _RetryCallback?

        private

        def option_retry_after: [T] (T & ^(RequestMethods request, ResponseMethods | ErrorResponse response) -> interval) -> T
                              | (Symbol value) -> (^(RequestMethods request, ResponseMethods | ErrorResponse response) -> interval)
                              | (_ToF value) -> Float

        def option_retry_jitter: [T] (^(interval jitter) -> interval) -> T

        def option_max_retries: (_ToI value) -> Integer

        def option_retry_change_requests: (boolish) -> boolish

        def option_retry_on: (_RetryCallback value) -> _RetryCallback
      end

      def self.extra_options: [T] (OptionsMethods options) -> T

      module InstanceMethods : Session
        def max_retries: (int) -> instance

        private

        def fetch_response: (RequestMethods request, Selector selector, OptionsMethods options) -> (ResponseMethods | ErrorResponse)?

        def retryable_request?: (RequestMethods request, ResponseMethods | ErrorResponse response, OptionsMethods options) -> boolish

        def retryable_response?: (ResponseMethods | ErrorResponse response, OptionsMethods options) -> boolish

        def retryable_error?: (_Exception error, OptionsMethods options) -> boolish

        def try_partial_retry: (RequestMethods request, ResponseMethods | ErrorResponse response) -> void

        def prepare_to_retry: (RequestMethods request, ResponseMethods | ErrorResponse response, interval? retry_after) -> void

        def can_reconnect?: (RequestMethods request, ResponseMethods | ErrorResponse response) -> bool

        def when_to_retry: (RequestMethods request, ResponseMethods | ErrorResponse response, OptionsMethods options) -> interval?
      end

      module RequestMethods : Request
        # attr_reader options: OptionsMethods

        attr_accessor retries: Integer

        attr_writer partial_response: ResponseMethods | ErrorResponse?

        def response=: (ResponseMethods | ErrorResponse response) -> void
      end

      module ResponseMethods : Response
        def from_partial_response: (ResponseMethods response) -> void
      end
    end
  end
end
