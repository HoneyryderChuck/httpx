module HTTPX
  module Plugins
    module ServerSentEvents
      def self.load_dependencies: (singleton(Session)) -> void

      def self.subplugins: () -> Hash[Symbol, Module]

      type sseOptions = Options & Stream::OptionsMethods & OptionsMethods
      type sseRequest = Request & Stream::RequestMethods & RequestMethods

      class Message
        attr_reader data: String
        attr_reader id: _ToS?
        attr_reader event: _ToS?
        attr_reader retry_after: Integer?

        def initialize: (data: String, ?event: _ToS?, ?id: _ToS?, ?retry_after: Integer?) -> void
      end

      module OptionsMethods : Options, Stream::OptionsMethods
        attr_reader event_stream: boolish

        private

        def option_event_stream: (boolish) -> boolish
      end

      module InstanceMethods : Session, Stream::InstanceMethods
      end

      module RequestMethods : Request, Stream::RequestMethods
        attr_accessor last_server_sent_message: Message?
      end

      module StreamResponseMethods : StreamResponse
        def each_message: () { (Message) -> void } -> void
                 | () -> Enumerable[Message]

        private

        def raise_format_error: (String line) -> void
      end

      module ServerSentEventsRetries
        type sseRetriesOptions = Options & Stream::OptionsMethods & Retries::OptionsMethods & ServerSentEvents::OptionsMethods
        type sseRetriesRequest = Request & Stream::RequestMethods & Retries::RequestMethods & ServerSentEvents::RequestMethods & Plugins::_WithOptions[sseRetriesOptions]

        module InstanceMethods : Session, Stream::InstanceMethods, ServerSentEvents::InstanceMethods, Retries::InstanceMethods
          private

          def prepare_to_retry: (sseRetriesRequest request, Retries::retriesResponse | ErrorResponse response, interval? retry_after) -> void

          def when_to_retry: (sseRetriesRequest request, Retries::retriesResponse | ErrorResponse response, sseRetriesOptions options) -> interval?
        end
      end
    end
  end
end
