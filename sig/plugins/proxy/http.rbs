module HTTPX
  module Plugins
    module Proxy
      module HTTP
        module OptionsMethods : Options
          attr_reader proxy_headers: Headers?

          attr_reader enable_proxy_tunnel: boolish

          private

          def option_proxy_headers: (heaheaders_input | Headers value) -> Headers

          def enable_proxy_tunnel: (boolish) -> boolish
        end

        module InstanceMethods : Session
          def with_proxy_basic_auth: (Hash[Symbol, untyped] opts) -> instance

          def with_proxy_digest_auth: (Hash[Symbol, untyped] opts) -> instance

          def with_proxy_ntlm_auth: (Hash[Symbol, untyped] opts) -> instance
        end

        module ConnectionMethods : Connection
          @tunnel_parser: Connection::HTTP1 | Connection::HTTP2

          def __http_proxy_connect: () ->  void
          def __http_on_connect: (top, Response) ->  void
        end

        module ProxyParser : Connection::HTTP1
        end

        class ConnectRequest < Request
          def initialize: (generic_uri uri, OptionsMethods options) -> void
        end
      end
    end

    type httpProxy = Session & Proxy::HTTP::InstanceMethods
  end
end
