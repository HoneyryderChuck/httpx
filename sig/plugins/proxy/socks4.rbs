module HTTPX
  class Socks4Error < ProxyError
  end

  module Plugins
    module Proxy
      module Socks4
        VERSION: Integer
        CONNECT: Integer
        GRANTED: Integer
        PROTOCOLS: Array[String]

        def self.extra_options: [T] (T & OptionsMethods options) -> T

        module ConnectionMethods : Connection, Proxy::ConnectionMethods
          def __socks4_proxy_connect: () ->  void
          def __socks4_on_packet: (String packet) ->  void
          def on_socks4_error: (string) -> void
        end

        class SocksParser
          include HTTPX::Callbacks

          @buffer: Buffer
          @options: Proxy::proxyOptions

          def close: () -> void
          def consume: (*untyped) -> void
          def empty: () -> bool
          def <<: (string) -> void

          private

          def initialize: (Buffer buffer, Proxy::proxyOptions options) -> void
        end

        module Packet
          def self?.connect: (Parameters, uri) -> String
        end
      end
    end
  end
end
