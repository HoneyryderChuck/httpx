module HTTPX
  class Socks5Error < ProxyError
  end

  module Plugins
    module Proxy
      module Socks5
        VERSION: Integer
        NOAUTH: Integer
        PASSWD: Integer
        NONE: Integer
        CONNECT: Integer
        IPV4: Integer
        DOMAIN: Integer
        IPV6: Integer
        SUCCESS: Integer

        def self.ProxyParser: (singleton(Session)) -> void

        def self.extra_options: [T] (T & OptionsMethods options) -> T

        def self.load_dependencies: (singleton(Session)) -> void

        module ConnectionMethods : Connection, Proxy::ConnectionMethods
          private

          def __socks5_proxy_connect: () ->  void

          def __socks5_on_packet: (String packet) ->  void

          def __socks5_check_version: (int version) -> void

          def __on_socks5_error: (string message) -> void
        end

        class SocksParser
          include HTTPX::Callbacks

          @buffer: Buffer
          @options: Proxy::proxyOptions

          def close: () -> void

          def consume: (*untyped) -> void

          def empty: () -> bool

          def <<: (string) -> void

          private

          def initialize: (Buffer buffer, Proxy::proxyOptions options) -> void
        end

        module Packet
          def self?.negotiate: (Parameters parameters) -> String
          def self?.authenticate: (Parameters parameters) -> String
          def self?.connect: (uri uri) -> String
        end
      end
    end
  end
end
