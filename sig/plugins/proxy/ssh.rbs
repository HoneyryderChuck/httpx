module HTTPX
  module Plugins
    module Proxy
      module SSH
        type sshProxyOptions = Options & OptionsMethods

        def self.load_dependencies: (singleton(Session)) -> void

        module OptionsMethods : Options
          attr_reader proxy: Hash[Symbol, untyped]

          private

          def option_proxy: (_ToHash[Symbol, untyped]) -> Hash[Symbol, untyped]
        end

        module InstanceMethods : Session
          @gateway: Net::SSH::Gateway

          private

          def build_gateway_socket: (int port, http_uri request_uri, sshProxyOptions options) -> _ToIO
        end

        module ConnectionMethods : Connection
          def coalescable?: (Connection connection) -> bool
        end
      end
    end


    type sessionSSHProxy = Session & Proxy::SSH::InstanceMethods
  end
end
