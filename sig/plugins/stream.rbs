module HTTPX
  module Plugins
    module Stream
      STREAM_REQUEST_OPTIONS: Hash[Symbol, untyped]

      type streamOptions = Options & OptionsMethods
      type streamRequest = Request & RequestMethods
      type streamResponse = Response & ResponseMethods
      type streamSession = Session & InstanceMethods

      def self.extra_options: [T] (T & Options options) -> T 

      module OptionsMethods : Options
        attr_reader stream: boolish

        attr_reader stream_response_class: singleton(StreamResponse)

        private

        def option_stream: (boolish) -> boolish

        def option_stream_response_class: [T] (T & singleton(StreamResponse)) -> T
      end

      module InstanceMethods : Session
        private

        def request: (*Request, **untyped?) -> (response | Array[response] | StreamResponse)
                   | (*untyped, **untyped?) -> (response | Array[response] | StreamResponse)
      end

      module RequestMethods : Request
        attr_accessor stream: StreamResponse?
      end

      module ResponseMethods : Response
        def stream: () -> StreamResponse?
      end

      module ResponseBodyMethods : Response::Body
        @stream: StreamResponse?
      end
    end
  end

  class StreamResponse
    include _ToS

    attr_reader request: Plugins::Stream::streamRequest
    @options: Plugins::Stream::streamOptions

    @session: Plugins::Stream::streamSession
    @response_enum: Enumerator[String]?
    @buffered_chunks: Array[String]
    @on_chunk: ^(String) -> void | nil

    def each: () { (String) -> void } -> void
            | () -> Enumerable[String]

    def each_line: () { (String) -> void } -> void
                 | () -> Enumerable[String]

    def on_chunk: (string) -> void

    def initialize: (Plugins::Stream::streamRequest, Plugins::Stream::streamSession) -> void

    private

    def response: () -> response
  end
end
