module HTTPX
  module Chainable
    def request: (Request, **untyped) -> response
               | (*Request, **untyped) -> Array[response]
               | (verb, uri, **untyped) -> response
               | (verb, [uri], **untyped) -> response
               | (Array[[verb, uri] | [verb, uri, request_params]], **untyped) -> Array[response]
               | (verb, _Each[uri | [uri, request_params]], **untyped) -> Array[response]

    def accept: (String) -> Session
    def wrap: () { (Session) -> void } -> void

    def with: (options) -> instance
            | (options) { (instance) -> void } -> void

    def plugin: (:auth, ?options) -> Plugins::Auth::InstanceMethods
              | (:basic_auth, ?options) -> Plugins::BasicAuth::InstanceMethods
              | (:digest_auth, ?options) -> Plugins::DigestAuth::InstanceMethods
              | (:ntlm_auth, ?options) -> Plugins::NTLMAuth::InstanceMethods
              | (:ntlm_v2_auth, ?options) -> Plugins::NTLMV2Auth::InstanceMethods
              | (:aws_sdk_authentication, ?options) -> Plugins::AwsSdkAuthentication::InstanceMethods
              | (:brotli, ?options) -> Session
              | (:cookies, ?options) -> Plugins::Cookies::InstanceMethods
              | (:expect, ?options) -> Session
              | (:follow_redirects, ?options) -> Plugins::FollowRedirects::InstanceMethods
              | (:upgrade, ?options) -> Plugins::Upgrade::InstanceMethods
              | (:h2c, ?options) -> Plugins::Upgrade::InstanceMethods
              | (:h2, ?options) -> Plugins::Upgrade::InstanceMethods
              | (:fiber_concurrency, ?options) -> Plugins::FiberConcurrency::InstanceMethods
              | (:persistent, ?options) -> Plugins::Persistent::InstanceMethods
              | (:proxy, ?options) -> Plugins::Proxy::HTTP::InstanceMethods
              | (:push_promise, ?options) -> Plugins::PushPromise::InstanceMethods
              | (:retries, ?options) -> Plugins::Retries::InstanceMethods
              | (:rate_limiter, ?options) -> Plugins::RateLimiter::InstanceMethods
              | (:stream, ?options) -> Plugins::Stream::InstanceMethods
              | (:stream_bidi, ?options) -> Plugins::StreamBidi::InstanceMethods
              | (:server_sent_events, ?options) -> Plugins::ServerSentEvents::InstanceMethods
              | (:aws_sigv4, ?options) -> Plugins::AWSSigV4::InstanceMethods
              | (:grpc, ?options) -> Plugins::GRPC::InstanceMethods
              | (:cache, ?options) -> Plugins::Cache::InstanceMethods
              | (:response_cache, ?options) -> Plugins::ResponseCache::InstanceMethods
              | (:circuit_breaker, ?options) -> Plugins::CircuitBreaker::InstanceMethods
              | (:oauth, ?options) -> Plugins::OAuth::InstanceMethods
              | (:callbacks, ?options) -> Plugins::Callbacks::InstanceMethods
              | (:content_digest, ?options) -> Plugins::ContentDigest::InstanceMethods
              | (:ssrf_filter, ?options) -> Plugins::SsrfFilter::InstanceMethods
              | (:webdav, ?options) -> Plugins::WebDav::InstanceMethods
              | (:xml, ?options) -> Plugins::XML::InstanceMethods
              | (:query, ?options) -> Plugins::Query::InstanceMethods
              | (:tracing, ?options) -> Session
              | (:hedging, ?options) -> Plugins::Hedging::InstanceMethods
              | (Symbol | Module, ?options) { (Class) -> void } -> Session
              | (Symbol | Module, ?options) -> Session

    private

    def default_options: () -> Options
    def branch: (options) -> Session
              | (options) { (Session) -> void } -> Session
  end
end
