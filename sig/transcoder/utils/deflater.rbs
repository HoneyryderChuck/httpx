module HTTPX
  module Transcoder
    class Deflater
      extend Forwardable

      @body: BodyReader
      @buffer: Response::Buffer?
      @closed: bool

      attr_reader content_type: String

      def initialize: (body_encoder body) -> void

      def initialize_dup: (Deflater orig) -> void

      def replayable?: () -> bool

      def bytesize: () -> (Integer | Float)

      def read: (?int? length, ?string? outbuf) -> String?

      def close: () -> void

      def deflate: (String? chunk) -> String?

      def rewind: () -> void

      private

      def buffer_deflate!: () -> Response::Buffer

    end
  end
end
